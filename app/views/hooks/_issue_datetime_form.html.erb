<% if issue && form && RedmineIssueDatetime.enabled_for?(issue.tracker_id) %>
  <%= javascript_include_tag 'issue_datetime', plugin: 'redmine_issue_datetime' %>
  <%= stylesheet_link_tag 'issue_datetime', plugin: 'redmine_issue_datetime' %>
  <%#
    Rendered detached and moved next to the matching date field by
    issue_datetime.js, because Redmine offers no hook inside the date rows.
    Each control is wrapped in the element carrying the target, so a control and
    its label move together; the time inputs drop their visible label (the
    neighbouring "Start date" label already names the row) and carry an
    aria-label instead.
  %>
  <div id="issue-datetime-fields" class="issue-datetime-pending">
    <span class="issue-datetime-inline" data-issue-datetime-target="start_date_area">
      <%= form.time_field :start_time,
                          step: RedmineIssueDatetime.time_step_seconds,
                          label: '',
                          class: 'issue-datetime-time',
                          aria: {label: l(:field_start_time)},
                          title: l(:field_start_time) %>
    </span>
    <span class="issue-datetime-inline" data-issue-datetime-target="due_date_area">
      <%= form.time_field :due_time,
                          step: RedmineIssueDatetime.time_step_seconds,
                          label: '',
                          class: 'issue-datetime-time',
                          aria: {label: l(:field_due_time)},
                          title: l(:field_due_time) %>
    </span>
    <span class="issue-datetime-allday" data-issue-datetime-target="due_date_area">
      <%= check_box_tag 'issue[all_day]', '1', issue.all_day,
                        id: 'issue_all_day', class: 'issue-datetime-all-day' %>
      <label for="issue_all_day"><%= l(:field_all_day) %></label>
    </span>
  </div>
<% end %>
